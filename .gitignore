# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and environments
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
*.log

# Local Data Cache (preserve directory structure and README)
cache/*
!cache/README.md
!cache/**/.gitkeep
